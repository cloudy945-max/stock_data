TUSHARE_TOKEN=your_tushare_token_here
AKShare_ENABLED=true
TUSHARE_ENABLED=true

DB_PATH=/path/to/stock_data/data/stock_data.duckdb
DATA_DIR=/path/to/stock_data/data

MAX_CONCURRENT=4

REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.0
MAX_RETRIES=5

FINANCIAL_UPDATE_FREQ=weekly
FINANCIAL_WEEKLY_DAY=5

MAIL_ENABLED=false
MAIL_SMTP_SERVER=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_RECEIVERS=["receiver1@example.com", "receiver2@example.com"]

PROXY_ENABLED=false
PROXY_URL=http://proxy:port

UPDATE_DAILY=true
UPDATE_VALUATION=true
UPDATE_FINANCIAL=true

CONNECTION_POOL_SIZE=8
